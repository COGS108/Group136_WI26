#5a). frequency table: count of purchases per price tier by gender ---
price_gender_counts = (
    clothing_df.groupby(['Gender', 'Price per Unit'])
    .size()
    .unstack(fill_value=0)
)
print('=== Transaction Counts by Gender x Price Tier ===')
print(price_gender_counts)
print()

#5b :proportion table: what % of each gender falls in each price tier
price_gender_pct = price_gender_counts.div(price_gender_counts.sum(axis=1), axis=0) * 100
print('=== Proportion (%) by Gender x Price Tier ===')
print(price_gender_pct.round(1))
print()

#5(c). Bar chart: side-by-side proportions per price tier
fig, axes = plt.subplots(1, 2, figsize=(14, 5))

#left: raw counts
price_gender_counts.T.plot(kind='bar', ax=axes[0], color=['#F4A582', '#92C5DE'], edgecolor='black')
axes[0].set_title('Transaction Count by Price Tier and Gender', fontsize=12)
axes[0].set_xlabel('Price per Unit ($)')
axes[0].set_ylabel('Number of Transactions')
axes[0].set_xticklabels(axes[0].get_xticklabels(), rotation=0)
axes[0].legend(title='Gender')

#right: proportions
price_gender_pct.T.plot(kind='bar', ax=axes[1], color=['#F4A582', '#92C5DE'], edgecolor='black')
axes[1].set_title('Proportion (%) by Price Tier and Gender', fontsize=12)
axes[1].set_xlabel('Price per Unit ($)')
axes[1].set_ylabel('Percentage (%)')
axes[1].set_xticklabels(axes[1].get_xticklabels(), rotation=0)
axes[1].legend(title='Gender')

plt.tight_layout()
plt.show()

#5(d)normality check: since Price per Unit is discrete/ordinal, ---
# we verify it is NOT normally distributed => use non-parametric tests
from scipy import stats

female_prices = clothing_df[clothing_df['Gender'] == 'Female']['Price per Unit']
male_prices   = clothing_df[clothing_df['Gender'] == 'Male']['Price per Unit']

stat_f, p_f = stats.shapiro(female_prices)
stat_m, p_m = stats.shapiro(male_prices)
print(f'Shapiro-Wilk test (Female): W={stat_f:.4f}, p={p_f:.4e}')
print(f'Shapiro-Wilk test (Male):   W={stat_m:.4f}, p={p_m:.4e}')
print()
print('Since price tiers are discrete (only 5 values), the distribution is')
print('NOT continuous/normal => Mann-Whitney U test is appropriate for Step 7.')






#Calculate min and max for specific columns in the clothing dataset
min_max_stats = clothing_df[['Total Amount', 'Price per Unit']].agg(['min', 'max'])

print("Clothing Category: Range of Prices and Totals")
print(min_max_stats)


#6a) verified Price per Unit (cross-check)
clothing_df = clothing_df.copy()  # avoid SettingWithCopyWarning
clothing_df['Verified Price per Unit'] = clothing_df['Total Amount'] / clothing_df['Quantity']

#flag inconsistent rows (should be 0 if data is clean)
inconsistent = clothing_df[
    clothing_df['Verified Price per Unit'] != clothing_df['Price per Unit']
]
print(f'Inconsistent rows (Verified != Original): {len(inconsistent)}')
if len(inconsistent) > 0:
    print(inconsistent[['Gender', 'Quantity', 'Price per Unit', 'Total Amount', 'Verified Price per Unit']])
print()

# 6b. High-value Purchase Flag
#1 = Price per Unit >= $300 (high-tier: $300 or $500),
#0 = otherwise
clothing_df['High_Value_Flag'] = (clothing_df['Price per Unit'] >= 300).astype(int)

print('=== High-Value Purchase Flag by Gender ===')
hv_table = clothing_df.groupby(['Gender', 'High_Value_Flag']).size().unstack(fill_value=0)
hv_table.columns = ['Low-Value (< $300)', 'High-Value (>= $300)']
hv_table['High-Value Rate (%)'] = (
    hv_table['High-Value (>= $300)'] /
    hv_table.sum(axis=1) * 100
).round(1)
print(hv_table)
print()

# 6c. Multi-item Purchase Flag
# 1 -> bought more than 1 item in this transaction, 0 ->single item
clothing_df['Multi_Item_Flag'] = (clothing_df['Quantity'] > 1).astype(int)

print('=== Multi-Item Purchase Flag by Gender ===')
mi_table = clothing_df.groupby(['Gender', 'Multi_Item_Flag']).size().unstack(fill_value=0)
mi_table.columns = ['Single Item', 'Multi Item']
mi_table['Multi-Item Rate (%)'] = (
    mi_table['Multi Item'] /
    mi_table.sum(axis=1) * 100
).round(1)
print(mi_table)
print()

#6(d) visualization of the two flags
fig, axes = plt.subplots(1, 2, figsize=(12, 4))

#High-value rate by gender
hv_rate = clothing_df.groupby('Gender')['High_Value_Flag'].mean() * 100
hv_rate.plot(kind='bar', ax=axes[0], color=['#F4A582', '#92C5DE'], edgecolor='black', width=0.5)
axes[0].set_title('High-Value Purchase Rate by Gender (>= $300)', fontsize=11)
axes[0].set_ylabel('Rate (%)')
axes[0].set_xticklabels(axes[0].get_xticklabels(), rotation=0)
axes[0].set_ylim(0, 100)
for p in axes[0].patches:
