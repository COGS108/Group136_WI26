# Load raw dataset
df = pd.read_csv(file2_path)

print("Initial Data Shape:", df.shape)
print("\nColumns:", df.columns.tolist())

# Check unique product categories to identify clothing-related items
print("\nUnique Product Categories:")
print(df['Product_Category'].unique())








clothing_df = df[df['Product_Category'].isin(['Apparel', 'Headgear'])].copy()

print(f"Filtered Data Shape: {clothing_df.shape}")





clothing_df.dropna(subset=['Product_Description', 'Avg_Price', 'Transaction_ID'], inplace=True)

# Fill missing values in non-critical columns
# 'Coupon_Code' likely has NaNs where no coupon was used
clothing_df['Coupon_Code'] = clothing_df['Coupon_Code'].fillna('No Coupon')
clothing_df['Discount_pct'] = clothing_df['Discount_pct'].fillna(0.0)

# Remove duplicate rows if any
clothing_df.drop_duplicates(inplace=True)

# Convert Date column to datetime objects
clothing_df['Transaction_Date'] = pd.to_datetime(clothing_df['Transaction_Date'])

print("Data cleaned of missing values and duplicates.")





def extract_product_gender(description):
    # Convert description to lowercase for easier searching
    desc = str(description).lower()

    # Define keywords
    if any(x in desc for x in ['youth', 'toddler', 'infant', 'onesie', 'kids']):
        return 'Kids'
    elif 'women' in desc:
        return 'Women'
    elif 'men' in desc:
        return 'Men'
    else:
        return 'Unisex/Other'

# Apply the function to create a new column
clothing_df['Product_Gender'] = clothing_df['Product_Description'].apply(extract_product_gender)

# Check the distribution
print(clothing_df['Product_Gender'].value_counts())





adult_clothing = clothing_df[clothing_df['Product_Gender'].isin(['Men', 'Women'])].copy()





def get_clothing_type(desc):
    desc = str(desc).lower()
    if any(word in desc for word in ['tee', 't-shirt', 'shirt', 'polo']):
        return 'T-Shirts & Shirts'
    elif any(word in desc for word in ['hoodie', 'jacket', 'sweatshirt', 'pullover', 'vest', 'softshell']):
        return 'Outerwear'
    else:
        return 'Other'

# Apply the categorization
adult_clothing['Clothing_Type'] = adult_clothing['Product_Description'].apply(get_clothing_type)

# Drop 'Other' if you only want the main clean categories
analysis_df = adult_clothing[adult_clothing['Clothing_Type'] != 'Other'].copy()

# Keep only unique products so we don't count the same shirt 500 times
unique_catalog = analysis_df.groupby(['Product_Description', 'Product_Gender', 'Clothing_Type'])['Avg_Price'].median().reset_index()

print(unique_catalog.groupby(['Clothing_Type', 'Product_Gender']).size())






plt.figure(figsize=(9, 6))

# A boxplot shows the median, spread, and outliers of the prices
sns.boxplot(data=unique_catalog, x='Clothing_Type', y='Avg_Price', hue='Product_Gender', palette=['#3498db', '#e74c3c'])

plt.title('Price Distribution of Unique Items: Men vs. Women')
plt.xlabel('Clothing Sub-Category')
plt.ylabel('Standard Item Price (USD)')
plt.legend(title='Target Gender')

